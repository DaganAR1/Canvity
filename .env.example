# Postgres connection string (Vercel Postgres, Supabase, Neon, or local)
DATABASE_URL="postgresql://user:password@localhost:5432/canvity?schema=public"

# NextAuth — generate with `openssl rand -base64 32`
AUTH_SECRET=""
# Your deployed URL (http://localhost:3000 in development)
NEXTAUTH_URL="http://localhost:3000"

# Encrypts each user's Canvas token at rest — must be 32 bytes, base64 encoded.
# Generate with `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=""

# Web push (VAPID) — generate all three with `npm run generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Syllabus scanning — reads each course syllabus for dates and policies.
# Get a key at https://console.anthropic.com. The rest of the app works without it.
ANTHROPIC_API_KEY=""

# Email digests via Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="Canvity <notifications@yourdomain.com>"

# Shared secret for cron endpoints — generate with `openssl rand -base64 32`
CRON_SECRET=""
