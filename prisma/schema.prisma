generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  createdAt     DateTime  @default(now())

  canvasAccount     CanvasAccount?
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]

  digestEnabled    Boolean   @default(true)
  digestHour       Int       @default(7) // hour of day, in `timeZone`, to send the daily digest
  lastDigestSentAt DateTime?

  // IANA zone name (e.g. "America/Los_Angeles"). Defaults to UTC until the
  // client detects and saves the real one; everything timezone-sensitive
  // (timeline "today", digest send time, notification text) reads this.
  timeZone String @default("UTC")

  // Paid-plan flag. Wired through the app now so gating exists from the start,
  // but nobody is charged yet — everyone runs as free until billing is live.
  isPro Boolean @default(false)

  studyPreference StudyPreference?
  studyBlocks     StudyBlock[]
}

// How this student wants their week to look. Collected once via a short
// questionnaire, then used to lay study blocks into the hours they actually
// have free — and to put the hardest work in the hours they focus best.
model StudyPreference {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hours per week the student wants to study. The scheduler treats this as a
  /// ceiling, not a quota — it won't invent work to fill the time.
  weeklyTargetHours Float @default(10)
  /// Length of one focused block. Sessions are never split below this.
  sessionMinutes    Int   @default(50)
  breakMinutes      Int   @default(10)
  /// Cap per day, so a looming deadline can't schedule an eight-hour Saturday.
  maxHoursPerDay    Float @default(4)

  /// Earliest/latest wall-clock hour (0-23) the student is willing to study, in
  /// their own timeZone.
  earliestHour Int @default(9)
  latestHour   Int @default(22)

  /// The window where they focus best — highest-priority work is placed here
  /// first. Same 0-23 wall-clock scale.
  peakStartHour Int @default(9)
  peakEndHour   Int @default(12)

  /// Days they're willing to study, as ISO weekday numbers (1 = Monday .. 7 = Sunday).
  studyDays Int[] @default([1, 2, 3, 4, 5, 6, 7])

  /// Minimum lead time before a deadline that work should be finished, in hours.
  /// Keeps the plan from scheduling an essay block that ends ten minutes before
  /// it is due.
  finishAheadHours Int @default(12)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One planned (or completed) chunk of study time. Generated blocks are replaced
// wholesale on each re-plan; blocks the student created or completed are kept.
model StudyBlock {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What this block is for. Exactly one is set for generated blocks; both are
  // null for a block the student added freehand.
  assignmentId   String?
  assignment     Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  syllabusItemId String?
  syllabusItem   SyllabusItem? @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)

  /// Shown when the block isn't tied to an assignment (e.g. "Review Chem ch. 4").
  title String?

  startAt DateTime
  endAt   DateTime

  /// "planned" | "done" | "skipped"
  status String @default("planned")
  /// False for blocks the student added by hand, which re-planning must not delete.
  isGenerated Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, startAt])
  @@index([assignmentId])
}

model CanvasAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain        String // e.g. canvas.instructure.com

  /// How this account reads Canvas: "token" (full REST API) or "feed" (the
  /// student's private calendar feed URL, which needs no token and no admin
  /// approval — the only route available where an institution disables
  /// student token generation).
  connectionType String @default("token")

  /// AES-encrypted Canvas API personal access token. Null for feed accounts.
  encryptedToken String?
  /// AES-encrypted calendar feed URL. The URL itself embeds a secret that
  /// grants read access to the student's calendar, so it is stored encrypted
  /// exactly like a token. Null for token accounts.
  encryptedFeedUrl String?

  lastSyncedAt  DateTime?
  lastSyncError String?
  createdAt     DateTime @default(now())

  courses Course[]
}

model Course {
  id              String   @id @default(cuid())
  canvasAccountId String
  canvasAccount   CanvasAccount @relation(fields: [canvasAccountId], references: [id], onDelete: Cascade)
  canvasCourseId  String
  name            String
  courseCode      String?
  // User-adjustable importance multiplier for this course (0.5 - 2.0), default 1.0
  weight          Float    @default(1.0)
  isActive        Boolean  @default(true)

  // Syllabus scanning state
  syllabusSource    String?   // where the text came from, e.g. "Canvas syllabus page" or "syllabus.pdf"
  syllabusHash      String?   // sha256 of the source text; unchanged hash skips re-extraction
  syllabusScannedAt DateTime?
  syllabusError     String?

  assignments   Assignment[]
  syllabusItems SyllabusItem[]

  @@unique([canvasAccountId, canvasCourseId])
}

// Something worth knowing that was pulled out of a course syllabus — an exam
// date, a project milestone, a drop deadline, a grading policy. These often
// never exist as Canvas assignments, which is exactly why they get missed.
model SyllabusItem {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  kind       String // "exam" | "quiz" | "project" | "assignment" | "deadline" | "reading" | "policy" | "resource" | "other"
  title      String
  detail     String?
  date       DateTime? // null for undated facts like a grading breakdown
  // True when the syllabus gave a date with no time ("Oct 3"), stored as that
  // calendar date's UTC midnight — a marker, not a real instant. False means
  // `date` is a genuine instant, resolved from the syllabus's naive wall-clock
  // time against the course owner's timeZone at extraction time.
  isAllDay   Boolean   @default(true)
  endDate    DateTime? // set when the item spans a range
  importance String    @default("medium") // "high" | "medium" | "low" — as judged from the syllabus
  // The sentence this came from, so the user can sanity-check the extraction.
  sourceQuote String?

  priorityScore Float  @default(0)
  priorityTier  String @default("normal")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationLogs NotificationLog[]
  studyBlocks      StudyBlock[]

  @@index([courseId])
  @@index([date])
}

model Assignment {
  id                String   @id @default(cuid())
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  canvasAssignmentId String
  name              String
  description       String?
  htmlUrl           String?
  dueAt             DateTime?
  pointsPossible    Float?
  groupWeight       Float?   // weight (%) of the assignment group this belongs to, if set on the course
  submittedAt       DateTime?
  hasSubmitted      Boolean  @default(false)
  /// True when the due date carried no time of day. Feed-derived assignments
  /// can be date-only; REST-derived ones always have a real instant.
  isAllDay          Boolean  @default(false)

  // computed priority score (higher = more urgent/important), recomputed on every sync
  priorityScore     Float    @default(0)
  priorityTier      String   @default("normal") // "critical" | "high" | "normal" | "low"

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  notificationLogs NotificationLog[]
  studyBlocks      StudyBlock[]

  @@unique([courseId, canvasAssignmentId])
  @@index([dueAt])
  @@index([priorityScore])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

// Tracks which notifications have already gone out so cron jobs never send
// duplicates. Exactly one of assignmentId / syllabusItemId is set per row.
model NotificationLog {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignmentId   String?
  assignment     Assignment?   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  syllabusItemId String?
  syllabusItem   SyllabusItem? @relation(fields: [syllabusItemId], references: [id], onDelete: Cascade)
  channel        String // "push" | "email"
  kind           String // "due_24h" | "due_72h_critical" | "digest"
  sentAt         DateTime      @default(now())

  @@unique([userId, assignmentId, channel, kind])
  @@unique([userId, syllabusItemId, channel, kind])
}
